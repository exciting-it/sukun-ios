    "Ramadan mode shows Suhoor and Iftar times. If Ramadan starts a day earlier or later where you live, adjust the Hijri date.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramadan mode shows Suhoor and Iftar times. If Ramadan starts a day earlier or later where you live, adjust the Hijri date."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ramadan-Modus zeigt Suhoor- und Iftar-Zeiten. Beginnt der Ramadan bei dir einen Tag früher oder später, passe das Hidschri-Datum an."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض وضع رمضان أوقات السحور والإفطار. إذا بدأ رمضان في بلدك قبل يوم أو بعده، فعدّل التاريخ الهجري."
          }
        }
      }
    },
