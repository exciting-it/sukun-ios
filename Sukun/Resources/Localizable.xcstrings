    "Sukun calculates everything on your device. No accounts, no tracking, no ads.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukun calculates everything on your device. No accounts, no tracking, no ads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukun berechnet alles auf deinem Gerät. Keine Konten, kein Tracking, keine Werbung."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحسب سكون كل شيء على جهازك. بلا حسابات ولا تتبّع ولا إعلانات."
          }
        }
      }
    },
