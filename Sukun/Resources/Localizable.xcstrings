    "On Fridays. “Before Dhuhr” follows the season; a set time suits mosques with a fixed khutbah.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Fridays. “Before Dhuhr” follows the season; a set time suits mosques with a fixed khutbah."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freitags. „Vor Dhuhr“ folgt der Jahreszeit; eine feste Uhrzeit passt zu Moscheen mit fester Khutba-Zeit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أيام الجمعة. «قبل الظهر» يتبع الموسم، والوقت المحدد يناسب المساجد ذات موعد خطبة ثابت."
          }
        }
      }
    },
