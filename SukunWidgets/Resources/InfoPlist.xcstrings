    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukun uses your location to calculate accurate prayer times and the Qibla direction, in the app and in its widgets. Your location stays on your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sukun verwendet deinen Standort, um genaue Gebetszeiten und die Qibla-Richtung zu berechnen – in der App und in den Widgets. Dein Standort bleibt auf deinem Gerät."
          }
        }
      }
    }
  },
  "version": "1.0"
}
